# Keycloak server base URL (no trailing slash needed)
KEYCLOAK_URL=http://localhost:8080

# Administrator account the server uses for Admin REST API calls.
# Real values belong in .env (gitignored) or the process environment,
# never in commits.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Realm the administrator account lives in (default: master)
KEYCLOAK_ADMIN_REALM=master
