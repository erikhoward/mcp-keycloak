# Keycloak server base URL (no trailing slash needed)
KEYCLOAK_URL=http://localhost:8080

# Administrator account the server uses for Admin REST API calls.
# Real values belong in .env (gitignored) or the process environment,
# never in commits.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Alternatively, use a confidential client with a service account.
# Configure either username/password or client ID/secret, not both.
# KEYCLOAK_ADMIN_CLIENT_ID=mcp-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# Realm the administrator account lives in (default: master)
KEYCLOAK_ADMIN_REALM=master

# Maximum duration for each Keycloak HTTP request (default: 30s)
KEYCLOAK_TIMEOUT=30s

# Optional PEM CA bundle for private Keycloak deployments.
# TLS verification remains enabled; do not use this to disable verification.
# KEYCLOAK_CA_CERT_FILE=/path/to/private-ca.pem

# Advertise only read-only tools and reject all mutations (default: false)
# KEYCLOAK_READ_ONLY=true
